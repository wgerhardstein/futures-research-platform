# Copy to .env and fill in. .env is gitignored and must never be committed.
# Names only -- no real values belong in this file.

# Signal tool (signals/): free Alpaca account -> Paper Trading -> API Keys. Read-only market data; no orders are sent.
ALPACA_API_KEY=<key-id>
ALPACA_SECRET_KEY=<secret>

# Futures execution layer (execution/) only
BROKER_GATEWAY=<broker-gateway-host:port>
BROKER_SYSTEM_NAME=<system-name>
BROKER_USER=<username>
BROKER_PASS=<password>
ACCOUNT_ID=<account-id>

TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_CHAT_ID=<chat-id>
